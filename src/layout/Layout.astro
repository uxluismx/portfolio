---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Navbar from "../components/Navbar.astro";
import { ClientRouter } from "astro:transitions";

import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  isActive: string; /* Para permitir otros valores sin romper el componente, aunque idealmente debería ser un union type de los posibles valores */
  navbar?: boolean;
}

const { title, isActive, navbar } = Astro.props;

// Transición del contenido: el anterior sube y se desenfoca, el nuevo entra desde abajo.
// Al regresar (botón atrás) la dirección se invierte. Keyframes en global.css.
const contentTransition = {
  forwards: {
    old: { name: "contentOutUp", duration: "180ms", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
    new: { name: "contentInUp", duration: "360ms", delay: "80ms", easing: "cubic-bezier(0.2, 0.8, 0.2, 1)", fillMode: "both" },
  },
  backwards: {
    old: { name: "contentOutDown", duration: "180ms", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
    new: { name: "contentInDown", duration: "360ms", delay: "80ms", easing: "cubic-bezier(0.2, 0.8, 0.2, 1)", fillMode: "both" },
  },
};
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/images/favicon.webp" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <Analytics />
    <title>{title}</title>
    <style>
      body {
        position: relative;
        margin-block-start: 1.5rem;
        margin-block-end: 6rem;
        /* Agregar patrón de fondo con una imagen svg */
        background-image: url("/images/resource-bg.svg");
        background-repeat: repeat;
      }

      .main-container {
        max-width: 40rem;
        background: var(--semantic-on-surface-low);
        border-radius: var(--radii-large);
        margin: 0 auto;
        overflow: clip;
      }

      .slot-container {
        padding: 2rem;
        padding-block-start: 1rem;
        gap: 2rem;
      }

      #navbar {
        width: 100%;
        position: fixed;
        bottom: 0;
        z-index: 10;
        justify-content: center;
        padding-block-end: 1.5rem;
      }

      @media screen and (max-width: 640px) {
        body {
          margin-block-start: 0;
          background: var(--semantic-on-surface-low);
          margin-block-end: 4.5rem;
        }

        .main-container {
          border-radius: 0;
          border: none;
          box-shadow: none;
        }
      }

      @media screen and (max-width: 440px) {
        .main-container {
          & > * {
            padding: 1rem;
          }
        }

        #navbar {
          padding-block-end: 1rem;
        }
      }
    </style>
  </head>

  <body>
    <!-- La tarjeta y el header se mantienen fijos; solo el contenido se anima -->
    <main
      class="main-container flex-column stroke-xsmall"
      transition:name="page-card"
      transition:animate="initial"
    >
      <Header />
      <article
        class="slot-container flex-column"
        transition:name="page-content"
        transition:animate={contentTransition}
      >
        <slot />
      </article>
    </main>
    {
      navbar !== false && (
        <div id="navbar" class="flex-row">
          <Navbar isActive={isActive} />
        </div>
      )
    }
  </body>
</html>
<SpeedInsights />
