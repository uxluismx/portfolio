---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Navbar from "../components/Navbar.astro";
import { ClientRouter } from "astro:transitions";
import { fadeUp, CONTENT_DELAY } from "../utils/pageTransitions";
import { persona, sitio, type SchemaNode } from "../utils/schema";
import type { PaginaActiva } from "../types";

import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  isActive: PaginaActiva;
  navbar?: boolean;
  description?: string; // meta description y descripción al compartir
  image?: string; // ruta en /public de la imagen al compartir
  imageAlt?: string;
  largeImage?: boolean; // true para imágenes horizontales (tarjeta grande en X/Twitter)
  noindex?: boolean; // excluye la página de buscadores (por ejemplo, 404)
  schema?: SchemaNode[]; // nodos JSON-LD propios de la página (ver utils/schema.ts)
}

const {
  title,
  isActive,
  navbar,
  description = "Luis Erick, Product Designer. Diseño webs y software con +5 años de experiencia en proyectos SaaS, E-learning y Fintech.",
  image = "/images/og-default.jpg",
  imageAlt = "Foto de perfil de Luis Erick",
  largeImage = false,
  noindex = false,
  schema = [],
} = Astro.props;

// JSON-LD: Person y WebSite en todas las páginas indexables, más los nodos de cada página.
// `<` se escapa para que el contenido no pueda cerrar el <script>.
const jsonLd = noindex
  ? null
  : JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [persona, sitio, ...schema],
    }).replace(/</g, "\\u003c");

// URLs absolutas a partir de `site` (astro.config.mjs)
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// El contenido entra 200ms después del Hero (ver utils/pageTransitions.ts)
const contentTransition = fadeUp(CONTENT_DELAY);
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/images/favicon.webp" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <Analytics />
    <title>{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph (vista previa al compartir en LinkedIn, WhatsApp, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Luis Erick" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content={largeImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Datos estructurados -->
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}

    <style>
      body {
        position: relative;
        margin-block-start: 1.5rem;
        margin-block-end: 6rem;
        /* Agregar patrón de fondo con una imagen svg */
        background-image: url("/images/resource-bg.svg");
        background-repeat: repeat;
      }

      .main-container {
        max-width: 40rem;
        background: var(--semantic-on-surface-low);
        border-radius: var(--radii-large);
        margin: 0 auto;
        overflow: clip;
      }

      .slot-container {
        padding: 2rem;
        padding-block-start: 1rem;
        gap: 2rem;
      }

      #navbar {
        width: 100%;
        position: fixed;
        bottom: 0;
        z-index: 10;
        justify-content: center;
        padding-block-end: 1.5rem;
      }

      @media screen and (max-width: 640px) {
        body {
          margin-block-start: 0;
          background: var(--semantic-on-surface-low);
          margin-block-end: 4.5rem;
        }

        .main-container {
          border-radius: 0;
          border: none;
          box-shadow: none;
        }
      }

      @media screen and (max-width: 440px) {
        .main-container {
          & > * {
            padding: 1rem;
          }
        }

        #navbar {
          padding-block-end: 1rem;
        }
      }
    </style>
  </head>

  <body>
    <!-- La tarjeta y el header se mantienen fijos; solo el contenido se anima -->
    <main
      class="main-container flex-column stroke-xsmall"
      transition:name="page-card"
      transition:animate="initial"
    >
      <Header />
      <article
        class="slot-container flex-column"
        transition:name="page-content"
        transition:animate={contentTransition}
      >
        <slot />
      </article>
    </main>
    {
      navbar !== false && (
        <div id="navbar" class="flex-row" transition:name="site-navbar" transition:animate="none">
          <Navbar isActive={isActive} />
        </div>
      )
    }
    <SpeedInsights />
  </body>
</html>
