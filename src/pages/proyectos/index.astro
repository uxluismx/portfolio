---
import Layout from "../../layout/Layout.astro";
import Hero from "../../components/Hero.astro";
import NewProjectCard from "../../components/NewProjectCard.astro";
import { proyectos } from "../../data/proyectos";
import { paginaProyectos, migas } from "../../utils/schema";

const isActive = "Proyectos";
const title = `${isActive} | Luis Erick`;
const schema = [
  paginaProyectos("/proyectos/", proyectos),
  migas([
    ["Inicio", "/"],
    ["Proyectos", "/proyectos/"],
  ]),
];
---

<style>
  .projects-group {
    gap: 1.5rem;
  }
</style>

<Layout
  title={title}
  isActive={isActive}
  description="Proyectos de Luis Erick: landing pages, web apps y apps móviles para negocios de E-learning, fitness, salud y más."
  schema={schema}
>
  <Hero
    accentTitle="Mis proyectos."
    title="Dolores reales, soluciones viables."
    description="Explora los proyectos en los que colaboré con ideas y entregables de alta calidad."
  />
  <!-- Las tarjetas se editan en src/data/proyectos.ts -->
  <div class="projects-group flex-column">
    {proyectos.map((proyecto) => <NewProjectCard {...proyecto} />)}
  </div>
</Layout>
