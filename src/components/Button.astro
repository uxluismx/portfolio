---
import IconWrapper from './IconWrapper.astro';

interface Props {
  href: string;
  text: string;
  type?: "CTA" | "Light" | "Ghost" | "Link" | "White";
  size?: "MD" | "SM";
  nameIcon?: string;
  animation?: string | boolean;
  newPage?: boolean; /* Hacer que el enlace se abra en una nueva pestaña por default */
  iconOnly?: boolean; /* Solo el ícono (requiere nameIcon); `text` pasa a ser el aria-label */
}
const { type = "CTA", size = "MD", href, text, nameIcon, animation, newPage, iconOnly } =
  Astro.props;
---

<!-- Global para que los botones que genera el plugin de Shiki (bloques de código) usen
     las mismas clases: button + tipo + tamaño (+ icon-only) -->
<style is:global>
  .button {
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: 0.5rem;
    border-radius: var(--radii-full);
    text-decoration: none;
    transition: all 200ms ease-in-out;

    &:hover {
        transform: translateY(-2px);
      }

    /* Variants */
    &.cta {
      --background-custom: hsl(233, 22%, 8%);
      --text-custom: hsl(226, 32%, 92%);

      background: var(--background-custom);
      color: var(--text-custom);
    }

    &.light {
      background: var(--semantic-surface-alt-low);
      color: var(--semantic-primary);

      &:hover {
        background: var(--semantic-surface-alt-medium);
      }
    }

    &.ghost {
      background: transparent;
      color: var(--semantic-primary);
      border: 1.5px solid var(--semantic-border-low);

      &:hover {
        background: var(--semantic-surface-alt-low);
      }
    }

    &.white {
      background: var(--bw-white);
      color: var(--semantic-primary);

      &:hover {
        background: var(--semantic-surface-alt-low);
      }
    }

    &.link {
      background: transparent;
      color: var(--semantic-secondary);

      &:hover {
        background: var(--semantic-surface-alt-low);
      }
    }

    /* Sizes */
    &.md {
      min-height: 2.5rem;
      padding-inline: 1rem;
      padding-block: 0.5rem;
      font-size: 1rem;
      letter-spacing: -0.02rem;
      font-weight: var(--weight-semibold);
      line-height: 150%;
    }

    &.sm {
      min-height: 2rem;
      padding-inline: 0.75rem;
      padding-block: 0.34rem;
      font-size: 0.875rem;
      letter-spacing: -0.0175rem;
      font-weight: var(--weight-semibold);
      line-height: 150%;
    }

    /* Solo ícono: botón cuadrado del alto del tamaño */
    &.icon-only {
      padding: 0;
      flex-shrink: 0;
    }

    &.icon-only.md {
      width: 2.5rem;
      height: 2.5rem;
    }

    &.icon-only.sm {
      width: 2rem;
      height: 2rem;
    }

    /* Animations */
    &.animation-false {
      &:hover {
        transform: none;
      }
    }
  }
</style>

<a
  class:list={[
    "flex-row button",
    type?.toLowerCase(),
    size?.toLowerCase(),
    `animation-${animation}`,
    { "icon-only": iconOnly },
  ]}
  href={href}
  aria-label={iconOnly ? text : undefined}
  target={newPage === true ? "_blank" : "_self"}
  rel={newPage === true ? "noopener noreferrer" : undefined}
>
  {nameIcon && <IconWrapper name={nameIcon} size={size === "MD" ? "20" : "16"} />}
  {!iconOnly && text}
</a>
