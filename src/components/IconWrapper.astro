---
interface Props {
  name: string;
  size?: "12" | "16" | "20" | "24" | "28" | "32" | number;
  color?: string;
}

const { name, size = "24", color = "currentColor" } = Astro.props as Props;
---

{/* Decorativo: el texto o el aria-label del elemento padre describe la acción */}
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={color}
  aria-hidden="true"
  focusable="false"
>
  <use href={`/icons/${name}.svg`}></use>
</svg>
