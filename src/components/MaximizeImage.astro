---
import { CldImage } from "astro-cloudinary";
import IconWrapper from "./IconWrapper.astro";

interface Props {
  src: string;
  alt?: string;
  width?: number; // ancho para la imagen maximizada
  thumbWidth?: number; // ancho para la miniatura
}

const { src, alt = "", width = 2000, thumbWidth = 1200 } = Astro.props;
const id = `max-img-${Math.random().toString(36).slice(2, 11)}`;
---

<style>
  @keyframes fadeInOverlay {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes zoomIn {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .maximize-image {
    --transition-custom: all 150ms ease;
    display: block;
    margin-block: 0 1rem;
  }

  .img-btn {
    border: none;
    background: none;
    padding: 0;
    display: block;
    width: 100%;
    cursor: zoom-in;
    transition: var(--transition-custom);

    &:hover {
      filter: brightness(1.1);
      transform: scale(1.01);
    }
  }

  .thumb {
    width: 100%;
    height: auto;
    border: 0.5px solid var(--semantic-border-low);
    border-radius: var(--radii-medium);
    display: block;
    transition: var(--transition-custom);
  }

  /* display: none mientras está cerrado para que la imagen grande (lazy) no se descargue */
  .max-overlay {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.88);
    z-index: 9999;
    padding: 1rem;
    backdrop-filter: blur(2px);
    cursor: zoom-out;

    &.open {
      display: flex;
      animation: fadeInOverlay 200ms ease forwards;

      .overlay-container {
        animation: zoomIn 200ms ease forwards;
      }
    }
  }

  .overlay-container {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    max-height: 100%;

    :global(img) {
      width: auto !important;
      height: auto;
      max-width: 100% !important;
      max-height: calc(100dvh - 2rem);
      object-fit: contain !important;
      border: 0.5px solid var(--semantic-border-low);
      border-radius: var(--radii-medium);
      cursor: default;
    }
  }

  .close-button {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: white;
    border-radius: 999px;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1;
    transition: var(--transition-custom);

    &:hover {
      background: rgba(255, 255, 255, 0.16);
      border-color: rgba(255, 255, 255, 0.24);
      transform: scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .maximize-image,
    .maximize-image * {
      animation-duration: 100ms !important;
      transition-duration: 100ms !important;
    }
  }
</style>

<div class="maximize-image" id={id}>
  <button class="img-btn" type="button" aria-label={`Maximizar imagen: ${alt}`}>
    <CldImage src={src} alt={alt} width={thumbWidth} loading="lazy" class="thumb" />
  </button>

  <div
    class="max-overlay"
    role="dialog"
    aria-modal="true"
    aria-label={alt || "Imagen maximizada"}
    aria-hidden="true"
  >
    <button class="close-button" type="button" aria-label="Cerrar imagen">
      <IconWrapper name="cross" size={24} />
    </button>
    <div class="overlay-container">
      <CldImage src={src} alt={alt} width={width} loading="lazy" class="full-image" />
    </div>
  </div>
</div>

<script define:vars={{ id }}>
  function initMaximizeImage() {
    const container = document.getElementById(id);
    if (!container) return;

    const btn = container.querySelector(".img-btn");
    const overlay = container.querySelector(".max-overlay");
    const close = container.querySelector(".close-button");
    if (!btn || !overlay || !close) return;

    function onKeydown(e) {
      if (e.key === "Escape") closeFn();
    }

    function open() {
      overlay.setAttribute("aria-hidden", "false");
      overlay.classList.add("open");
      document.body.style.overflow = "hidden";
      document.addEventListener("keydown", onKeydown);
      close.focus();
    }

    function closeFn() {
      overlay.setAttribute("aria-hidden", "true");
      overlay.classList.remove("open");
      document.body.style.overflow = "";
      document.removeEventListener("keydown", onKeydown);
      btn.focus();
    }

    btn.addEventListener("click", open);

    // Cerrar al hacer click fuera de la imagen (incluye el botón de cerrar)
    overlay.addEventListener("click", (e) => {
      if (e.target.tagName !== "IMG") closeFn();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMaximizeImage);
  } else {
    initMaximizeImage();
  }
</script>
