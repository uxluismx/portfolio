---
// Renderiza el contenido de un MDX con los componentes MDx* (clases de global.css).
// Lo usan las páginas de proyecto y el laboratorio de componentes (src/pages/lab-k7q2m/).
import type { render } from "astro:content";
import MDxH2 from "./MDxH2.astro";
import MDxH3 from "./MDxH3.astro";
import MDxP from "./MDxP.astro";
import MDxA from "./MDxA.astro";
import MDxStrong from "./MDxStrong.astro";
import MDxLi from "./MDxLi.astro";
import MDxUl from "./MDxUl.astro";
import MDxOl from "./MDxOl.astro";
import MDxImg from "./MDxImg.astro";
import MDxBlockquote from "./MDxBlockquote.astro";
import MDxHr from "./MDxHr.astro";
import MDxPre from "./MDxPre.astro";
import MDxCode from "./MDxCode.astro";
import MDxEm from "./MDxEm.astro";

interface Props {
  // Content de render() (colección) o de importar un .mdx directo
  Content: Awaited<ReturnType<typeof render>>["Content"];
}

const { Content } = Astro.props;
---

<style>
  .blog-content {
    /* Declaración de variables CSS */
    --line-height: 160%;

    /* Ajustes custom para el contenido Markdown */
    :global([class*="body"]) {
      line-height: var(--line-height);
    }

    :global(h2, h3, .code-block) {
      margin-block-start: 0;
      margin-block-end: 1rem;
    }

    :global(p, a, ul, ol, blockquote) {
      margin-block-start: 0;
      margin-block-end: 1rem;
    }

    :global(hr) {
      margin-block-start: 2rem;
      margin-block-end: 3rem;
    }

    :global(blockquote) {
      /* Maniobra para eliminar el margen de los párrafos dentro de blockquote */
      p {
        margin: 0;
      }
    }

    :global(p) {
      /* Maniobra para ajustar los margenes de las imágenes dentro de párrafos */
      img {
        margin-block: 1rem;
      }

      a {
        margin: 0;
      }
    }

    #blog-content :global(:first-child) {
      margin-block-start: 0;
    }

    #blog-content :global(:last-child) {
      margin-block-end: 0;
    }
  }</style>

<!-- El id lo usa el botón "Seguir leyendo" del Hero -->
<article class="blog-content flex-column" id="blog-content">
  <Content
    components={{
      h2: MDxH2,
      h3: MDxH3,
      p: MDxP,
      a: MDxA,
      strong: MDxStrong,
      li: MDxLi,
      ul: MDxUl,
      ol: MDxOl,
      img: MDxImg,
      blockquote: MDxBlockquote,
      hr: MDxHr,
      pre: MDxPre,
      code: MDxCode,
      em: MDxEm,
    }}
  />
</article>
