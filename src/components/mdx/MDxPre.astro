---
// Shiki ya entrega `<div class="code-block">` con la barra y el <pre>
// (ver src/plugins/shiki-bloques-codigo.mjs); aquí solo se pinta el <pre> y el wrapper
---

<style>
  pre {
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    line-height: 1.5;
    padding: 0.875rem 0;
    overflow-x: auto;
    tab-size: 2;
  }

  /* Los elementos de abajo los genera Shiki, por eso van con :global */
  :global(.code-block) {
    width: 100%;
    border: var(--stroke-small) solid var(--semantic-border-medium);
    border-radius: var(--radii-medium);
    background: var(--semantic-surface-alt-low);
    overflow: hidden;
  }

  :global(.code-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.75rem 0.625rem 1rem;
    border-bottom: var(--stroke-small) solid var(--semantic-border-medium);
    background: var(--semantic-surface-alt-medium);
  }

  :global(.code-meta) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  :global(.code-file) {
    font-size: 0.8125rem;
    font-weight: var(--weight-semibold);
    color: var(--semantic-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.code-lang) {
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--semantic-tertiary);
    background: var(--semantic-surface);
    border: var(--stroke-small) solid var(--semantic-border-medium);
    border-radius: var(--radii-full);
    padding: 0.125rem 0.5rem;
  }

  :global(.code-copy) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-family-body);
    font-size: 0.8125rem;
    font-weight: var(--weight-semibold);
    color: var(--semantic-secondary);
    background: var(--semantic-surface);
    border: var(--stroke-small) solid var(--semantic-border-high);
    border-radius: var(--radii-xsmall);
    padding: 0.25rem 0.625rem;
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;

    &:hover {
      background: var(--semantic-surface-alt-high);
      color: var(--semantic-zero);
    }

    &.copiado {
      color: var(--emerald-500);
      border-color: var(--emerald-300);
    }

    :global(svg) {
      width: 0.875rem;
      height: 0.875rem;
    }

    :global(span) {
      font-size: inherit;
      font-family: inherit;
    }
  }

  /* Un <code> con grid ignora los saltos de línea entre `.line`: no se duplica el interlineado */
  :global(.code-block code[class]) {
    display: grid;
    min-width: max-content;
    margin: 0;
    font: inherit;
    color: var(--semantic-primary);
    counter-reset: linea;

    /* Anula el diseño de código en línea de MDxCode */
    &::before {
      display: none;
    }

    :global(span) {
      font-family: inherit;
      font-size: inherit;
    }

    :global(.line) {
      padding: 0 1rem;
      counter-increment: linea;

      &::before {
        content: counter(linea);
        display: inline-block;
        width: 1.75rem;
        margin-right: 1rem;
        text-align: right;
        color: var(--gray-on-surface-50);
        user-select: none;
      }

      &.hl {
        background: color-mix(in srgb, var(--blue-400) 12%, transparent);
        box-shadow: inset 2px 0 0 var(--blue-400);
      }
    }
  }

  @media (max-width: 440px) {
    :global(.code-file) {
      display: none;
    }
  }
</style>

<pre {...Astro.props}><slot /></pre>

<script>
  // Delegado en document: sirve con ClientRouter sin reinicializar en cada navegación
  document.addEventListener("click", async (evento) => {
    const boton = (evento.target as HTMLElement).closest<HTMLButtonElement>("[data-copy]");
    if (!boton) return;

    const codigo = boton.closest(".code-block")?.querySelector("code")?.textContent ?? "";
    const etiqueta = boton.querySelector("span");
    try {
      await navigator.clipboard.writeText(codigo);
      boton.classList.add("copiado");
      if (etiqueta) etiqueta.textContent = "¡Copiado!";
    } catch {
      if (etiqueta) etiqueta.textContent = "No se pudo copiar";
    }
    setTimeout(() => {
      boton.classList.remove("copiado");
      if (etiqueta) etiqueta.textContent = "Copiar";
    }, 1600);
  });
</script>
