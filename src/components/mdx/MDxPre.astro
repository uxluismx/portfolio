---
// Shiki ya entrega `<div class="code-block">` con la barra y el <pre>
// (ver src/plugins/shiki-bloques-codigo.mjs); aquí solo se pinta el <pre> y el wrapper
---

<style>
  pre {
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    line-height: 1.5;
    /* Sale 0.5rem hacia el padding del bloque: el texto queda alineado con la barra
       y el fondo de las líneas resaltadas tiene aire a los lados */
    margin-inline: -0.5rem;
    overflow-x: auto;
    tab-size: 2;
  }

  /* Los elementos de abajo los genera Shiki, por eso van con :global */
  :global(.code-block) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    padding: 1rem;
    border: var(--stroke-small) solid var(--semantic-border-low);
    border-radius: var(--radii-medium);
    background: var(--bw-white);
  }

  :global(.code-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  :global(.code-meta) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  :global(.code-file) {
    font-size: 0.8125rem;
    font-weight: var(--weight-semibold);
    color: var(--semantic-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.code-lang) {
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--semantic-quaternary);
    background: var(--semantic-surface-alt-low);
    border-radius: var(--radii-full);
    padding: 0.125rem 0.5rem;
  }

  :global(.code-actions) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* La base viene de Button.astro (clases button light sm); aquí solo lo propio del bloque */
  :global(.code-btn) {
    border: none;
    cursor: pointer;

    &[aria-pressed="true"] {
      background: var(--semantic-secondary);
      color: var(--bw-white);
    }

    &.copiado {
      background: var(--emerald-50);
      color: var(--emerald-500);
    }

    :global(svg) {
      width: 1rem;
      height: 1rem;
    }

    :global(span) {
      font-size: inherit;
      font-family: inherit;
      font-weight: inherit;
    }
  }

  /* En pantallas táctiles el :hover se queda "pegado" después de tocar y se mezcla con los estados
     activo y copiado: ahí los botones conservan su fondo base. Se usa también pointer: coarse
     porque algunos navegadores móviles (Android) reportan hover: hover */
  @media (hover: none), (pointer: coarse) {
    :global(.code-btn.light) {
      -webkit-tap-highlight-color: transparent;
      transition: none;
    }

    :global(.code-btn.light:hover:not([aria-pressed="true"]):not(.copiado)) {
      background: var(--semantic-surface-alt-low);
    }
  }

  /* Un <code> con grid ignora los saltos de línea entre `.line`: no se duplica el interlineado */
  :global(.code-block code[class]) {
    display: grid;
    min-width: max-content;
    margin: 0;
    font: inherit;
    color: var(--semantic-secondary);
    counter-reset: linea;

    /* Anula el diseño de código en línea de MDxCode */
    &::before {
      display: none;
    }

    :global(span) {
      font-family: inherit;
      font-size: inherit;
    }

    :global(.line) {
      /* Sangría colgante (número de 1.5rem + 1rem de separación): si la línea se ajusta,
         la continuación queda debajo del código y no debajo del número */
      padding-inline: 3rem 0.5rem;
      text-indent: -2.5rem;
      counter-increment: linea;

      &::before {
        content: counter(linea);
        text-indent: 0;
        display: inline-block;
        width: 1.5rem;
        margin-right: 1rem;
        text-align: right;
        color: var(--gray-surface-900);
        user-select: none;
      }

      /* Resaltado invertido: un "modo oscuro" hecho con la misma escala de grises.
         Shiki pinta cada token con var(--astro-code-*), así que basta con redefinirlas aquí */
      &.hl {
        --astro-code-foreground: var(--gray-surface-400);
        --astro-code-token-keyword: var(--bw-white);
        --astro-code-token-function: var(--bw-white);
        --astro-code-token-parameter: var(--gray-surface-400);
        --astro-code-token-string: var(--blue-200);
        --astro-code-token-string-expression: var(--blue-200);
        --astro-code-token-constant: var(--blue-200);
        --astro-code-token-punctuation: var(--gray-surface-900);
        --astro-code-token-comment: var(--gray-surface-900);
        background: var(--semantic-secondary);

        &::before {
          color: var(--gray-surface-900);
        }
      }

      /* Las esquinas se redondean solo en los extremos de cada grupo de líneas resaltadas */
      &.hl:first-child,
      /* :global evita que Astro agregue su atributo de scope a .hl */
      &:not(.hl) + :global(.hl) {
        border-top-left-radius: var(--radii-xsmall);
        border-top-right-radius: var(--radii-xsmall);
      }

      &.hl:last-child,
      &.hl:has(+ :not(.hl)) {
        border-bottom-left-radius: var(--radii-xsmall);
        border-bottom-right-radius: var(--radii-xsmall);
      }
    }
  }

  /* Botón "Ajustar": las líneas largas bajan de renglón en vez de usar scroll horizontal */
  :global(.code-block.ajustado) {
    pre {
      overflow-x: visible;
    }

    :global(code[class]) {
      min-width: 0;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
  }

  @media (max-width: 440px) {
    :global(.code-file) {
      display: none;
    }
  }
</style>

<pre {...Astro.props}><slot /></pre>

<script>
  // Delegado en document: sirve con ClientRouter sin reinicializar en cada navegación
  document.addEventListener("click", async (evento) => {
    const objetivo = evento.target as HTMLElement;

    const ajustar = objetivo.closest<HTMLButtonElement>("[data-wrap]");
    if (ajustar) {
      const activo = ajustar.closest(".code-block")?.classList.toggle("ajustado") ?? false;
      ajustar.setAttribute("aria-pressed", String(activo));
      return;
    }

    const boton = objetivo.closest<HTMLButtonElement>("[data-copy]");
    if (!boton) return;

    const codigo = boton.closest(".code-block")?.querySelector("code")?.textContent ?? "";
    const etiqueta = boton.querySelector("span");
    try {
      await navigator.clipboard.writeText(codigo);
      boton.classList.add("copiado");
      if (etiqueta) etiqueta.textContent = "¡Copiado!";
    } catch {
      if (etiqueta) etiqueta.textContent = "No se pudo copiar";
    }
    setTimeout(() => {
      boton.classList.remove("copiado");
      if (etiqueta) etiqueta.textContent = "Copiar";
    }, 1600);
  });
</script>
