---
import Button from "./Button.astro";
import type { PaginaActiva } from "../types";

interface Props {
  isActive: PaginaActiva;
}

const { isActive } = Astro.props;
---

<style>
  .navbar {
    width: fit-content;
    background: var(--bw-white);
    padding: 0.5rem;
    gap: 0.5rem;
    border-radius: var(--radii-full);

    /* Dentro de .navbar: suelto (`& :global(.button)`) se aplicaba a todos los botones del sitio */
    :global(.button) {
      min-width: 6rem;
    }
  }
</style>

<nav
  class="flex-row navbar stroke-xsmall shadow-small"
  aria-label="Navegación secundaria: Paginas del portafolio"
>
  <Button
    href="/"
    type={isActive === "Inicio" ? "CTA" : "Link"}
    size="SM"
    text="Inicio"
    animation={false}
  />
  <Button
    href="/proyectos"
    type={isActive === "Proyectos" ? "CTA" : "Link"}
    size="SM"
    text="Proyectos"
    animation={false}
  />
  {/* Contacto abre el correo, nunca es la página activa */}
  <Button
    href="mailto:uxluismx@gmail.com"
    type="Link"
    size="SM"
    text="Contacto"
    animation={false}
  />
  <slot />
</nav>
